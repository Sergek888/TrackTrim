{
  "version": 8,
  "name": "TrackViewer OSM Vector",
  "glyphs": "https://fonts.openmaptiles.org/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["https://tiles.openfreemap.org/planet/{z}/{x}/{y}.pbf"],
      "maxzoom": 14,
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f7f5ef" } },
    { "id": "landcover", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "paint": { "fill-color": "#e6eedf", "fill-opacity": 0.45 } },
    { "id": "landuse", "type": "fill", "source": "openmaptiles", "source-layer": "landuse", "paint": { "fill-color": "#e6eedf", "fill-opacity": 0.4 } },
    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park", "minzoom": 5, "paint": { "fill-color": "#cde7c9", "fill-opacity": 0.55 } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "paint": { "fill-color": "#a7cbe8" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "minzoom": 8, "paint": { "line-color": "#a7cbe8", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 2] } },
    { "id": "boundary", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "minzoom": 4, "paint": { "line-color": "#9ca3af", "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.4, 10, 1.2], "line-dasharray": [3, 2] } },
    { "id": "roads-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 5, "paint": { "line-color": "#d1c7b8", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.6, 10, 2.2, 14, 6] } },
    { "id": "roads", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 5, "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.4, 10, 1.4, 14, 4] } },
    { "id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 13, "paint": { "fill-color": "#d8d1c5", "fill-opacity": 0.75 } },
    { "id": "place-labels", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 3, "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 3, 10, 8, 12, 12, 16], "text-anchor": "center" }, "paint": { "text-color": "#334155", "text-halo-color": "rgba(255,255,255,0.8)", "text-halo-width": 1 } },
    { "id": "poi-labels", "type": "symbol", "source": "openmaptiles", "source-layer": "poi", "minzoom": 14, "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 11, "text-anchor": "top", "text-offset": [0, 0.6] }, "paint": { "text-color": "#475569", "text-halo-color": "rgba(255,255,255,0.8)", "text-halo-width": 1 } }
  ]
}
